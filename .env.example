# Qdrant Vector Database Configuration
# For local persistent embedded storage, set QDRANT_PATH and leave QDRANT_URL empty
# For Qdrant Docker or remote service, set QDRANT_URL
QDRANT_URL=
QDRANT_PATH=data/data1/qdrant_db
QDRANT_COLLECTION=qa_knowledge
QDRANT_SPARSE_COLLECTION=qa_knowledge_sparse
QDRANT_API_KEY=

# Embedding Model Configuration (Local BGE, no external API calls)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=64

# Sparse Embedding Configuration (Local BM25 via FastEmbed)
SPARSE_MODEL_NAME=Qdrant/bm25
SPARSE_VECTOR_NAME=bm25
SPARSE_BATCH_SIZE=128
SPARSE_CHECKPOINT_DIR=data/sparse_checkpoints

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Indexing Configuration
INDEX_BATCH_SIZE=128

# Dataset and Schema Versioning
DATASET_VERSION=1.0.0
SCHEMA_VERSION=1.0.0

# Paths
DATA_DIR=data
RAW_DATA_DIR=data
PROCESSED_DATA_DIR=data/processed
QUARANTINE_DATA_DIR=data/quarantine
REPORTS_DIR=reports

# Groq LLM Configuration (Router & Answer Generator)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.0

# Retrieval & Reranker Configuration
RERANKER_MODEL=BAAI/bge-reranker-base
DENSE_TOP_K=30
SPARSE_TOP_K=30
RERANKER_TOP_K=50
FINAL_EVIDENCE_TOP_K=5
RRF_K=60
RERANKER_BATCH_SIZE=16

# LLM Provider Configuration ('groq' | 'kaggle' | 'colab')
LLM_PROVIDER=groq
ROUTER_LLM_PROVIDER=
GENERATOR_LLM_PROVIDER=
JUDGE_LLM_PROVIDER=

# Kaggle / Colab / Remote LLM Endpoint (OpenAI-compatible)
# When LLM_PROVIDER=kaggle, set this to the ngrok public URL generated in Kaggle:
KAGGLE_LLM_BASE_URL=
KAGGLE_LLM_API_KEY=EMPTY
KAGGLE_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
COLAB_LLM_BASE_URL=
COLAB_LLM_API_KEY=EMPTY
COLAB_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
